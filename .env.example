121PORT=3420
DATABASE_URL=postgres://watchlater:watchlater@localhost:5433/watchlater
RUST_LOG=watchlater=info,tower_http=info

# Web Push (optional — leave unset to run without notifications)
# Generate a VAPID key pair, then paste values below.
# Easy way with Node/npx: `npx web-push generate-vapid-keys`
# Or with openssl:
#   openssl ecparam -genkey -name prime256v1 -out vapid.pem
#   openssl ec -in vapid.pem -pubout -outform DER | tail -c 65 | base64 | tr '+/' '-_' | tr -d '=\n'
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:aquulsmurf@gmail.com
